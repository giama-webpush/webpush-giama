# Copiá este archivo como .env y completá. Nunca subas el .env al repositorio.

# --- Servidor ---
PORT=3000
# URL pública con https en producción (la usan los links de clic y el manifest)
BASE_URL=http://localhost:3000
NODE_ENV=development
# HOST=0.0.0.0
# Detrás de un proxy (Render, Nginx, Cloudflare) poné true para leer la IP real y https
TRUST_PROXY=false
# Forzar cookie Secure (por defecto: true si NODE_ENV=production)
# COOKIE_SECURE=true

# --- Acceso al panel ---
ADMIN_USER=admin
# Mínimo 8 caracteres. Sin esto el panel queda bloqueado.
ADMIN_PASSWORD=
# API key para POST /api/subscribers/tag, POST /api/campaigns/send y /api/cron/tick
ADMIN_KEY=

# --- VAPID (npm run vapid las genera y las escribe acá sin mostrarlas) ---
# Si se cambian, todas las suscripciones existentes dejan de funcionar.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:avisos@tudominio.com.ar

# --- Base de datos ---
# Opción A: Turso / libSQL remoto (recomendado en hosting sin disco persistente)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Opción B: archivo SQLite local (necesita disco persistente). Se usa si no hay TURSO_*.
DB_PATH=./data/webpush.db
# libsql (por defecto) o node-sqlite (módulo nativo de Node, solo archivo local)
# DB_DRIVER=libsql

# --- Teléfonos ---
# Secreto para la huella (HMAC) del teléfono. Si no se define se genera y guarda en la base.
PHONE_HASH_SECRET=
# Opcional: frase secreta larga (se deriva una clave AES-256) para guardar también el teléfono cifrado y verlo en el panel
PHONE_ENC_KEY=

# --- Marca ---
# Carpeta opcional con logo.png, icon-192.png, icon-512.png, icon-maskable-512.png, badge-96.png, apple-touch-icon.png, favicon.png
# Tiene prioridad sobre public/brand
BRAND_DIR=

# --- Ajustes ---
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Tamaño máximo de imagen subida (se guarda dentro de la base)
MAX_UPLOAD_KB=700
SCHEDULER_INTERVAL_MS=15000
SEND_CONCURRENCY=10
SEND_BATCH_SIZE=200
SESSION_HOURS=12
# UPLOADS_DIR ya no se usa: las imágenes se guardan en la base (tabla media).
