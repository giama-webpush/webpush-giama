{
  "name": "webpush-giama",
  "version": "1.0.0",
  "private": true,
  "description": "Generador y administrador de notificaciones WebPush (Peugeot Giama): suscripción con etiquetas, público, piezas y campañas.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "vapid": "node --disable-warning=ExperimentalWarning scripts/vapid.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\"",
    "lint": "eslint .",
    "test:node-sqlite": "TEST_DB_DRIVER=node-sqlite node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^5.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0"
  }
}
